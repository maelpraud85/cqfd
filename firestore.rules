rules_version = '2';
// Règles de sécurité de la base CQFD : à coller dans Firebase > Firestore > Règles.
// Seules les personnes passées par l'appli (connexion anonyme) peuvent lire et écrire,
// et seulement dans les 5 collections de l'appli.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{coll}/{id} {
      allow read, write: if request.auth != null
        && coll in ['activites', 'notes', 'votes', 'palmares', 'config'];
    }
  }
}
